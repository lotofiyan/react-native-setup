{
  "name": "test-app",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:e2e": "node ./e2e/home.e2e.js",
    "e2e:ios:build": "detox build -c ios.sim.debug",
    "e2e:ios:test": "detox test -c ios.sim.debug",
    "e2e:android:build": "detox build -c android.emu.debug",
    "e2e:android:test": "detox test -c android.emu.debug",
    "e2e:ios:argos": "npm run argos:clear && detox test -c ios.sim.debug --record-logs none --record-videos none --artifacts-location __argos__ --take-screenshots manual && npm run argos:upload",
    "argos:clear": "rm -rf __argos__/* || true",
    "argos:snap": "node scripts/capture-argos.js",
    "argos:upload": "argos upload __argos__"
  },
  "dependencies": {
    "@expo/html-elements": "^0.10.1",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/core": "^3.0.12",
    "@gluestack-ui/utils": "^3.0.13",
    "@legendapp/motion": "^2.5.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.29",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.19",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-aria": "^3.44.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-stately": "^3.42.0",
    "tailwind-variants": "^0.1.20"
  },
  "devDependencies": {
    "@argos-ci/cli": "^1.0.1",
    "@storybook/addons": "^6.5.7",
    "@storybook/react-native": "^6.5.7",
    "@storybook/theming": "^6.5.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.46.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.16",
    "playwright": "^1.49.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  },
  "private": true
}
